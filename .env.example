# wiTTy's Translation Rescue - environment template
# Copy to .env.local (never commit real values). All variables are optional
# unless marked REQUIRED for that deployment mode.

# --- Event selection -------------------------------------------------------
# Which src/config/events/<id>.json to use. Reuse at another roadshow by adding
# a new event file and changing this value. Default: discover-2026
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing.
NEXT_PUBLIC_EVENT_ID=discover-2026

# --- Data collection -------------------------------------------------------
# server  = queue in the browser (IndexedDB) and sync to /api/events (default)
# browser = keep records only in the browser queue; export via the staff panel
# off     = collect nothing
NEXT_PUBLIC_COLLECTION_MODE=server
# Set to "true" to make /api/events refuse all records.
COLLECTION_DISABLED=false
# Folder for the JSONL data files (relative to the app folder). Keep it on the
# booth laptop's encrypted disk; it is git-ignored.
DATA_DIR=data
# Records older than this many days are purged automatically.
RETENTION_DAYS=90

# --- Admin dashboard (REQUIRED to enable /admin) -----------------------------
# Generate both with: npm run admin:hash -- "<passcode of 12+ characters>"
# Wrap the hash in single quotes: it contains '$' characters.
ADMIN_PASSCODE_HASH=
ADMIN_SESSION_SECRET=
